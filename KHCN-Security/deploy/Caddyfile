{
	admin off
	auto_https off
	persist_config off
}

https://localhost:8443, https://127.0.0.1:8443 {
	bind 127.0.0.1
	tls .runtime/tls/server-chain.pem .runtime/tls/server.key {
		protocols tls1.2 tls1.3
	}
	encode gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
	request_body {
		max_size 128KB
	}
	handle_path /static/* {
		root * staticfiles
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8003 {
			# Replace, never accept a client's assertion of HTTPS or its IP.
			header_up X-Forwarded-Proto https
			header_up -Forwarded
			header_up -X-Forwarded-Host
		}
	}
}

http://localhost:8080, http://127.0.0.1:8080 {
	bind 127.0.0.1
	header -Server
	redir https://localhost:8443{uri} 308
}
