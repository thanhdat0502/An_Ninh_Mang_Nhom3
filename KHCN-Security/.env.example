# Copy to .env; never commit .env. Values are for local development only.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional on DEBUG localhost; required, random and separate in production.
JWT_SIGNING_KEY=

POSTGRES_DB=khcn_security
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# Each must pass Django password validation; use three distinct passwords.
DEMO_ADMIN_PASSWORD=
DEMO_LECTURER_PASSWORD=
DEMO_STUDENT_PASSWORD=

# HTTPS demo uses a separate ignored .env.https generated by setup_https_demo.py.
# KHCN_HTTPS_SECRET_KEY and KHCN_HTTPS_JWT_SIGNING_KEY are generated independently.
# Keep this .env for local HTTP and PostgreSQL; never print either secrets file.
